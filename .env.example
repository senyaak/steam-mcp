# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
# (any domain works for registration, e.g. "localhost"). The key is permanent.
STEAM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Default player used when a tool is called without an explicit steam_id.
# A 17-digit SteamID64. Don't know yours? Call the resolve_steam_id tool with
# your vanity name / profile URL, then paste the result here.
STEAM_ID=7656119xxxxxxxxxx

# Optional: language for achievement names/descriptions (Steam `l` param).
# e.g. english | russian | german. Default: english.
# STEAM_LANG=english

# Optional: HTTP port to listen on (default 3846).
# PORT=3846

# Optional: override the on-disk cache directory (default: <project>/.cache).
# The Steam app list (~appid↔name map) is cached here so name search is fast.
# CACHE_DIR=/path/to/cache
